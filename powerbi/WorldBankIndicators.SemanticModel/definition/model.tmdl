model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder","WbCsv","dim_country","dim_indicator","dim_year","fct_indicator_value"]

ref table dim_country
ref table dim_indicator
ref table dim_year
ref table fct_indicator_value
