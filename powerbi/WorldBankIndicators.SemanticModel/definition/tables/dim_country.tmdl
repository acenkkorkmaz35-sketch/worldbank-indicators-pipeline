/// One row per country in scope (business key country_iso3). Income group = current WB classification.
table dim_country

	/// ISO 3166-1 alpha-3 code (business key).
	column country_iso3
		dataType: string
		summarizeBy: none
		sourceColumn: country_iso3

	column country_iso2
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: country_iso2

	column country_name
		dataType: string
		summarizeBy: none
		sourceColumn: country_name
		sortByColumn: sort_order

	column region_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: region_code

	column region_name
		dataType: string
		summarizeBy: none
		sourceColumn: region_name

	column income_group_code
		dataType: string
		summarizeBy: none
		sourceColumn: income_group_code

	column income_group_name
		dataType: string
		summarizeBy: none
		sourceColumn: income_group_name

	column lending_type_name
		dataType: string
		summarizeBy: none
		sourceColumn: lending_type_name

	column capital_city
		dataType: string
		summarizeBy: none
		sourceColumn: capital_city

	column longitude
		dataType: double
		summarizeBy: none
		sourceColumn: longitude
		dataCategory: Longitude

	column latitude
		dataType: double
		summarizeBy: none
		sourceColumn: latitude
		dataCategory: Latitude

	column sort_order
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: sort_order

	partition dim_country = m
		mode: import
		source =
				let
				    FileName = "dim_country.csv",
				    Raw = if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & FileName) else File.Contents(DataFolder & FileName),
				    Parsed = Csv.Document(Raw, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Parsed, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"longitude", type number}, {"latitude", type number}, {"sort_order", Int64.Type}}, "en-US")
				in
				    Typed

