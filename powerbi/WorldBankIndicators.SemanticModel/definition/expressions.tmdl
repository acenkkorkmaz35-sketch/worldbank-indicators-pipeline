/// Folder or URL that holds the star-schema CSVs written by `python run.py` (output/powerbi/).
/// Default: the sample committed to the public GitHub repo, so the model opens anywhere.
/// After a local run, set it to the local folder, e.g. C:\code\worldbank-indicators-pipeline\output\powerbi\ (keep the trailing slash).
expression DataFolder = "https://raw.githubusercontent.com/acenkkorkmaz35-sketch/worldbank-indicators-pipeline/main/output/powerbi/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	annotation PBI_ResultType = Text
